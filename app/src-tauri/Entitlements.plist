<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS code signing entitlements (bundle.macOS.entitlements). With the hardened runtime an app may record audio only
     with audio-input; the user still has to allow the microphone (NSMicrophoneUsageDescription in Info.plist). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
