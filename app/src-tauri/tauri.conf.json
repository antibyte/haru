{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haru",
  "version": "0.1.0",
  "identifier": "dev.haru.fluidlight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Haru", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["backends/**/*"],
    "publisher": "Haru",
    "shortDescription": "Haru - Flüssiges Licht",
    "longDescription": "Voice conversation with Haru, visualised as fluid light. Runs the speech.cpp worker locally.",
    "copyright": "Haru. Bundles speech.cpp (MIT).",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
