index 0000000..63b3c23
--- /dev/null
+++ b/checks/smoke/worker_battle_smoke.py
@@ -0,0 +1,157 @@
+"""Drives `speech worker` with a dialogue model through battles, two conversations of the model that hear each other in
+place of a caller, with every line checked by worker_client.py: one JSON object per line, and one terminal message per
+request and nothing after it.
+
+It checks: that ready lists the feature battle; that a battle of 8 frames sends, frame after frame, speaker 0's chunk
+and then speaker 1's, both numbered by the frame from 0, each a frame of the model's samples with a text, and ends with
+end and its 8 frames; that the same battle
+again sends the same chunks; that a hang_up ends a running battle after whole frames with end and its frames, and that
+a chunk to a running battle is refused without an id; that a cancel ends a running battle with cancelled, after which
+its chunk and hang_up are dropped; each refusal with its code and option; that a conversation after the battles runs as
+before, its chunks without a speaker; and that stdin closing ends a running battle as its hang_up does.
+
+usage: python3 checks/smoke/worker_battle_smoke.py <speech> <model.gguf> [-- worker options...]
+"""
+
+import base64
+import sys
+
+from worker_client import Worker, short
+
+args = sys.argv[1:]
+flags = args[args.index("--") + 1:] if "--" in args else []
+args = args[:args.index("--")] if "--" in args else args
+if len(args) != 2:
+    raise SystemExit(__doc__)
+speech, model = args
+
+# A short battle, and the 10 minutes of a long one, whose keys and values are 0.3 GB a conversation for Haru-4B.
+FRAMES, TEN_MINUTES = 8, 4500
+SITUATION = "Haru and Mephisto argue whether a white lie is allowed. No human is present."
+# Speaker 0 opens and speaker 1 listens first.
+SPEAKERS = [
+    {"language": "en", "name": "Haru", "other_name": "Mephisto", "gender": "female", "backchannel": "mid",
+     "persona": "Haru is an angel who speaks gently and warmly and sides with honesty.",
+     "relationship": "Mephisto is a demon in the same machine whom Haru hopes to win over.",
+     "situation": SITUATION, "speak_first": True, "seed": 1001},
+    {"language": "en", "name": "Mephisto", "other_name": "Haru", "gender": "male", "backchannel": "low",
+     "persona": "Mephisto is an old demon who speaks slowly and coldly and praises the selfish side of every question.",
+     "relationship": "Haru is an angel in the same machine whom Mephisto wants to lead astray.",
+     "situation": SITUATION, "speak_first": False, "seed": 2002},
+]
+
+w = Worker(speech, model, flags)
+w.check_model_information()
+info = w.ready["model"]
+if info["task"] != "dialogue" or w.ready.get("features") != ["battle"]:
+    raise SystemExit(f"ready lists the features {w.ready.get('features')!r} for a model of {info['task']}; a dialogue model's are ['battle']")
+frame, rate = info["frame_samples"], info["sample_rate"]
+longest = next(o["maximum"] for o in info["options"] if o["name"] == "max_seconds")
+MOST = int(longest * rate / frame + 1e-9)
+SILENCE = base64.b64encode(bytes(frame * 2)).decode()
+print(f"ready: {info['name']}, the feature battle")
+
+
+def battle(id, max_frames=FRAMES, speakers=SPEAKERS):
+    w.request({"type": "battle", "id": id, "speakers": speakers, "max_frames": max_frames})
+
+
+def frames_of(messages):
+    """A battle's messages up to its terminal one, checked to be its chunks in pairs, speaker 0's and then speaker 1's
+    frame, numbered by the frame from 0, a frame of samples each: each speaker's PCM and text, the frames and the
+    terminal message."""
+    *chunks, last = messages
+    pcm, text = [b"", b""], ["", ""]
+    for i, m in enumerate(chunks):
+        seq, speaker = i // 2, i % 2
+        if m["type"] != "chunk" or m.get("seq") != seq or m.get("speaker") != speaker or not isinstance(m.get("text"), str):
+            raise SystemExit(f"message {i} of a battle is {short(m)}, not speaker {speaker}'s frame {seq}")
+        piece = base64.b64decode(m["pcm"])
+        if len(piece) != frame * 2:
+            raise SystemExit(f"speaker {speaker}'s frame {seq} holds {len(piece) // 2} samples, not a frame of {frame}")
+        pcm[speaker] += piece
+        text[speaker] += m["text"]
+    if len(chunks) % 2:
+        raise SystemExit(f"a battle ended after {len(chunks)} chunks, not two for each frame")
+    return pcm, text, len(chunks) // 2, last
+
+
+def nothing_more(why):
+    """Checks, through an info answered at once, that the lines sent before it got no answer."""
+    w.request({"type": "info", "id": "sentinel"})
+    w.terminal("sentinel", "end")
+    stray = [m for m in w.backlog if "id" not in m or m["id"] not in w.in_flight]
+    if stray:
+        raise SystemExit(f"{why}, and the worker answered {short(stray[0])}")
+
+
+battle("a")
+pcm, text, n, end = frames_of(w.until("a"))
+if end["type"] != "end" or end.get("frames") != FRAMES or n != FRAMES:
+    raise SystemExit(f"a battle of {FRAMES} frames ended with {short(end)} after {n} frames")
+print(f"a battle of {FRAMES} frames: speaker 0's chunk and then speaker 1's for each frame, numbered from 0; end with its frames")
+
+battle("b")
+again, again_text, _, _ = frames_of(w.until("b"))
+if (again, again_text) != (pcm, text):
+    raise SystemExit("the same battle with the same seeds gave other frames")
+print("the same battle again: the same frames and text")
+
+# A hang_up ends a running battle after the frame under way; a chunk to it is refused without an id.
+battle("c", TEN_MINUTES)
+head = [w.next_for("c") for _ in range(8)]
+w.send({"type": "chunk", "id": "c", "seq": 0, "pcm": SILENCE})
+w.error_without_id("invalid_argument", "id")
+w.send({"type": "hang_up", "id": "c"})
+_, _, n, end = frames_of(head + w.until("c"))
+if end["type"] != "end" or end.get("frames") != n or not 4 <= n < TEN_MINUTES:
+    raise SystemExit(f"a battle hung up after 4 frames ended with {short(end)} after {n} frames")
+print("hang_up: a running battle ended after whole frames with end and its frames; a chunk to it refused without an id")
+
+# A cancel ends a running battle; the chunk and hang_up its caller sends after the answer are dropped.
+battle("d", TEN_MINUTES)
+w.next_for("d")
+w.next_for("d")
+w.send({"type": "cancel", "id": "d"})
+w.terminal("d", "cancelled")
+w.send({"type": "chunk", "id": "d", "seq": 0, "pcm": SILENCE})
+w.send({"type": "hang_up", "id": "d"})
+nothing_more("a chunk and a hang_up followed a cancelled battle")
+print("cancel: a running battle ended with cancelled; its later chunk and hang_up dropped")
+
+for message, code, option in [
+        ({"type": "battle", "id": "e", "max_frames": FRAMES}, "invalid_argument", "speakers"),
+        ({"type": "battle", "id": "f", "speakers": SPEAKERS[:1], "max_frames": FRAMES}, "invalid_argument", "speakers"),
+        ({"type": "battle", "id": "g", "speakers": [SPEAKERS[0], {**SPEAKERS[1], "sample_rate": rate}], "max_frames": FRAMES},
+         "invalid_argument", "sample_rate"),
+        ({"type": "battle", "id": "h", "speakers": [{**SPEAKERS[0], "max_seconds": 60}, SPEAKERS[1]], "max_frames": FRAMES},
+         "invalid_argument", "max_seconds"),
+        ({"type": "battle", "id": "i", "speakers": SPEAKERS, "max_frames": FRAMES, "seed": 7}, "invalid_argument", "seed"),
+        ({"type": "battle", "id": "j", "speakers": SPEAKERS}, "invalid_argument", "max_frames"),
+        ({"type": "battle", "id": "k", "speakers": SPEAKERS, "max_frames": 0}, "invalid_argument", "max_frames"),
+        ({"type": "battle", "id": "l", "speakers": SPEAKERS, "max_frames": MOST + 1}, "out_of_range", "max_frames"),
+        ({"type": "battle", "id": "m", "speakers": [{**SPEAKERS[0], "speed": 1.5}, SPEAKERS[1]], "max_frames": FRAMES},
+         "unsupported", "speed")]:
+    w.request(message)
+    w.terminal(message["id"], "error", code, option)
+print("refusals: speakers missing or one, a speaker's member that is no option, a speaker's max_seconds, a seed beside "
+      "speakers, max_frames missing, 0 or past the model's longest conversation, an option the model does not take")
+
+w.request({"type": "dialogue", "id": "n", "sample_rate": rate, **SPEAKERS[0], "max_seconds": 60})
+for seq in range(3):
+    w.send({"type": "chunk", "id": "n", "seq": seq, "pcm": SILENCE})
+w.send({"type": "hang_up", "id": "n"})
+said = w.until("n")
+end = said[-1]
+if end["type"] != "end" or end.get("frames") != 4 or end.get("samples") != 4 * frame or any("speaker" in m for m in said):
+    raise SystemExit(f"a conversation after the battles ended with {short(end)}")
+print("a conversation after the battles: four frames without a speaker, end with frames and samples as before")
+
+battle("o", TEN_MINUTES)
+head = [w.next_for("o"), w.next_for("o")]
+rest = w.close()
+_, _, n, end = frames_of(head + [m for m in rest if m.get("id") == "o"])
+if end["type"] != "end" or end.get("frames") != n or n < 1:
+    raise SystemExit(f"stdin's end gave the battle {short(end)} after {n} frames, not its end")
+print("stdin closed: the running battle ended with end after whole frames; the worker exited with 0")
+print("battle smoke passed")
diff --git a/checks/worker/worker-battle-check.cpp b/checks/worker/worker-battle-check.cpp
new file mode 100644
index 0000000..ecb6c63
--- /dev/null
+++ b/checks/worker/worker-battle-check.cpp
@@ -0,0 +1,222 @@
+// Checks the worker's battle apart from any model: battle lines read, each refusal naming its input, a speaker's error
+// as the battle reports it, and the lockstep on fake speakers whose frames tell their speaker and number, so that what
+// each heard shows the order: in frame t each speaker hears the other's frame t - 1, speaker 0's frame goes out before
+// speaker 1's, and a hang_up or a cancel ends the battle before a frame. It needs no model, device or dump.
+//
+// usage: worker-battle-check
+
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <stdexcept>
+#include <string>
+#include <variant>
+#include <vector>
+
+#include "battle.h"
+#include "json-reader.h"
+
+namespace {
+
+int failures = 0;
+
+void expect(bool ok, const std::string & what) {
+    if (ok) return;
+    failures++;
+    std::printf("FAILED: %s\n", what.c_str());
+}
+
+const std::string kSpeaker0 = R"({"language":"de","name":"Haru","other_name":"Mephisto","speak_first":true,"seed":1001,"temperature":0.6})";
+const std::string kSpeaker1 = R"({"language":"de","name":"Mephisto","other_name":"Haru","speak_first":false,"seed":2002,"gender":null})";
+const std::string kTwo = "[" + kSpeaker0 + "," + kSpeaker1 + "]";
+
+/** A battle line with `speakers` and the members `rest`, which starts with a comma or is empty. */
+std::string battle_line(const std::string & speakers, const std::string & rest) {
+    return R"({"type":"battle","id":"b","speakers":)" + speakers + rest + "}";
+}
+
+/** Expects `line` refused, naming `want`, with a reason. */
+void refused(const std::string & line, const std::string & want) {
+    Battle b;
+    std::string option, problem;
+    const bool read = read_battle(parse_json(line), b, option, problem);
+    expect(!read, "read where it names " + want + ": " + line);
+    expect(read || option == want, "refused naming " + option + " where it names " + want + ": " + line);
+    expect(read || !problem.empty(), "refused without a reason: " + line);
+}
+
+/** The integer value of `option` among `options`, or -1 where it is absent or of another type. */
+int64_t integer_of(const std::vector<RequestOption> & options, speech_option option) {
+    for (const RequestOption & o : options) {
+        if (o.option != option) continue;
+        const int64_t * v = std::get_if<int64_t>(&o.value);
+        return v ? *v : -1;
+    }
+    return -1;
+}
+
+void check_reading() {
+    Battle b;
+    std::string option, problem;
+    expect(read_battle(parse_json(battle_line(kTwo, R"(,"max_frames":4500)")), b, option, problem),
+           "a whole battle line is refused: " + option + ": " + problem);
+    expect(b.max_frames == 4500, "max_frames is " + std::to_string(b.max_frames) + ", not 4500");
+    expect(b.speakers[0].size() == 6, "speaker 0 has " + std::to_string(b.speakers[0].size()) + " options, not 6");
+    // gender is null, which counts as left out.
+    expect(b.speakers[1].size() == 5, "speaker 1 has " + std::to_string(b.speakers[1].size()) + " options, not 5");
+    expect(integer_of(b.speakers[0], SPEECH_OPT_SEED) == 1001 && integer_of(b.speakers[1], SPEECH_OPT_SEED) == 2002,
+           "the seeds are not each speaker's own");
+    Battle least;
+    expect(read_battle(parse_json(battle_line("[{},{}]", R"(,"max_frames":1)")), least, option, problem) && least.max_frames == 1,
+           "a battle of one frame without options is refused: " + problem);
+    Battle most;
+    expect(read_battle(parse_json(battle_line("[{},{}]", R"(,"max_frames":2147483647)")), most, option, problem) &&
+               most.max_frames == 2147483647,
+           "a battle of INT_MAX frames is refused: " + problem);
+
+    refused(R"({"type":"battle","id":"b","max_frames":8})", "speakers");
+    refused(battle_line("{}", R"(,"max_frames":8)"), "speakers");
+    refused(battle_line("[" + kSpeaker0 + "]", R"(,"max_frames":8)"), "speakers");
+    refused(battle_line("[" + kSpeaker0 + "," + kSpeaker1 + "," + kSpeaker0 + "]", R"(,"max_frames":8)"), "speakers");
+    refused(battle_line("[" + kSpeaker0 + R"(,"Mephisto"])", R"(,"max_frames":8)"), "speakers");
+    refused(battle_line(R"([{"sample_rate":24000},{}])", R"(,"max_frames":8)"), "sample_rate");
+    refused(battle_line(R"([{},{"max_seconds":600}])", R"(,"max_frames":8)"), "max_seconds");
+    refused(battle_line(R"([{"seed":"1001"},{}])", R"(,"max_frames":8)"), "seed");
+    refused(battle_line(R"([{},{"speak_first":1}])", R"(,"max_frames":8)"), "speak_first");
+    refused(battle_line(kTwo, R"(,"max_frames":8,"seed":7)"), "seed");
+    refused(battle_line(kTwo, R"(,"max_frames":8,"sample_rate":24000)"), "sample_rate");
+    refused(battle_line(kTwo, ""), "max_frames");
+    for (const char * frames : {"0", "-3", "1.5", "1e3", "\"8\"", "true", "2147483648", "99999999999999"}) {
+        refused(battle_line(kTwo, std::string(R"(,"max_frames":)") + frames), "max_frames");
+    }
+}
+
+void check_failures() {
+    const Failure memory = speaker_failure(1, Failure("out_of_memory", "max_seconds", "the keys and values do not fit"));
+    expect(memory.code() == "out_of_memory" && memory.option() == "max_frames" &&
+               std::string(memory.what()) == "speaker 1: the keys and values do not fit",
+           "speaker 1's lack of memory became " + memory.code() + " (" + memory.option() + "): " + memory.what());
+    const Failure option = speaker_failure(0, Failure("unsupported", "speed", "Haru-4B does not take speed"));
+    expect(option.code() == "unsupported" && option.option() == "speed" && std::string(option.what()) == "speaker 0: Haru-4B does not take speed",
+           "speaker 0's refused option became " + option.code() + " (" + option.option() + "): " + option.what());
+}
+
+/**
+ * A speaker whose frame t holds `samples` copies of 100 * (index + 1) + t and the text "index:t", and which keeps each
+ * frame it heard; from frame `short_from` on, where it is set, its frames are a sample short.
+ */
+class Fake : public BattleSpeaker {
+public:
+    Fake(int index, int64_t samples) : index_(index), samples_(samples) {}
+
+    BattleFrame start() override {
+        starts++;
+        return next();
+    }
+
+    BattleFrame step(const std::vector<float> & h) override {
+        heard.push_back(h);
+        return next();
+    }
+
+    int starts = 0;
+    std::vector<std::vector<float>> heard;
+    int64_t short_from = -1;
+
+private:
+    BattleFrame next() {
+        const int64_t t = given_++;
+        const int64_t n = short_from >= 0 && t >= short_from ? samples_ - 1 : samples_;
+        return {std::vector<float>((size_t) n, (float) (100 * (index_ + 1) + t)), std::to_string(index_) + ":" + std::to_string(t)};
+    }
+
+    int index_;
+    int64_t samples_;
+    int64_t given_ = 0;
+};
+
+/** What the sink of a battle got: "speaker/seq/text" for each frame, in order. */
+using Sent = std::vector<std::string>;
+
+std::function<void(int, int64_t, const BattleFrame &)> into(Sent & sent) {
+    return [&sent](int speaker, int64_t seq, const BattleFrame & f) {
+        sent.push_back(std::to_string(speaker) + "/" + std::to_string(seq) + "/" + f.text);
+    };
+}
+
+void check_lockstep() {
+    Fake a(0, 4), b(1, 4);
+    Sent sent;
+    int asks = 0;
+    const BattleEnd end = run_battle(a, b, 5, 4, [&] { asks++; return BattleAsk::GoOn; }, into(sent));
+    expect(end.frames == 5 && end.stop == BattleStop::MaxFrames, "a battle of 5 frames ended after " + std::to_string(end.frames));
+    expect(asks == 5, "the battle asked " + std::to_string(asks) + " times, not once before each of its 5 frames");
+    expect(a.starts == 1 && b.starts == 1, "a speaker did not start exactly once");
+    Sent want;
+    for (int t = 0; t < 5; t++) {
+        for (int i = 0; i < 2; i++) want.push_back(std::to_string(i) + "/" + std::to_string(t) + "/" + std::to_string(i) + ":" + std::to_string(t));
+    }
+    expect(sent == want, "the frames went out in another order than speaker 0's and then speaker 1's, frame after frame");
+    bool crossed = a.heard.size() == 4 && b.heard.size() == 4;
+    for (size_t t = 0; crossed && t < 4; t++) {
+        crossed = a.heard[t] == std::vector<float>(4, (float) (200 + t)) && b.heard[t] == std::vector<float>(4, (float) (100 + t));
+    }
+    expect(crossed, "in some frame a speaker heard other than the other's frame before");
+}
+
+void check_stops() {
+    {
+        Fake a(0, 4), b(1, 4);
+        Sent sent;
+        int asks = 0;
+        const BattleEnd end = run_battle(a, b, 4500, 4, [&] { return ++asks > 3 ? BattleAsk::HangUp : BattleAsk::GoOn; }, into(sent));
+        expect(end.frames == 3 && end.stop == BattleStop::HangUp && sent.size() == 6,
+               "a hang_up before frame 3 ended after " + std::to_string(end.frames) + " frames with " + std::to_string(sent.size()) + " sent");
+    }
+    {
+        Fake a(0, 4), b(1, 4);
+        Sent sent;
+        const BattleEnd end = run_battle(a, b, 4500, 4, [] { return BattleAsk::Cancel; }, into(sent));
+        expect(end.frames == 0 && end.stop == BattleStop::Cancel && sent.empty() && a.starts == 0 && b.starts == 0,
+               "a cancel before frame 0 still ran a speaker");
+    }
+    {
+        Fake a(0, 4), b(1, 4);
+        Sent sent;
+        const BattleEnd end = run_battle(a, b, 4500, 4, [] { return BattleAsk::HangUp; }, into(sent));
+        expect(end.frames == 0 && end.stop == BattleStop::HangUp && sent.empty() && a.starts == 0 && b.starts == 0,
+               "a hang_up before frame 0 still ran a speaker");
+    }
+    {
+        Fake a(0, 4), b(1, 4);
+        b.short_from = 2;
+        Sent sent;
+        std::string what;
+        try {
+            run_battle(a, b, 10, 4, [] { return BattleAsk::GoOn; }, into(sent));
+        } catch (const std::runtime_error & e) {
+            what = e.what();
+        }
+        expect(what == "frame 2 of speaker 1 is 3 samples, not a frame of 4", "a frame a sample short gave \"" + what + "\"");
+        expect(sent.size() == 5, std::to_string(sent.size()) + " frames went out, not the 5 before the short one");
+    }
+}
+
+}  // namespace
+
+int main() {
+    check_reading();
+    std::printf("battle lines: a whole line read, each refusal naming its input\n");
+    check_failures();
+    std::printf("failures: a speaker's error keeps its code and names the speaker, and max_seconds as max_frames\n");
+    check_lockstep();
+    std::printf("lockstep: in frame t each speaker hears the other's frame t - 1, speaker 0's frame sent before speaker 1's\n");
+    check_stops();
+    std::printf("stops: after max_frames, at a hang_up and at a cancel before a frame; a frame of another length refused\n");
+    if (failures > 0) {
+        std::printf("worker-battle-check: %d failed\n", failures);
+        return 1;
+    }
+    std::printf("worker-battle-check: passed\n");
+    return 0;
+}
diff --git a/checks/worker/worker-inbox-check.cpp b/checks/worker/worker-inbox-check.cpp
new file mode 100644
index 0000000..41de544
--- /dev/null
+++ b/checks/worker/worker-inbox-check.cpp
@@ -0,0 +1,337 @@
+// Checks the worker's inbox on battle lines apart from any model: a battle refused on a model that is not a dialogue
+// model, under an id in flight, or with a chunk sent to it, a hang_up or a cancel read while it waits or runs, and the
+// lines dropped after its answer. The inbox is told the model's task and name and given a stdin that stays open, so that
+// each reading is told from the end of stdin. It needs no model, device or dump.
+//
+// usage: worker-inbox-check
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <filesystem>
+#include <future>
+#include <istream>
+#include <mutex>
+#include <random>
+#include <streambuf>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "cancellation.h"
+#include "inbox.h"
+#include "json-reader.h"
+
+namespace {
+
+int failures = 0;
+
+void expect(bool ok, const std::string & what) {
+    if (ok) return;
+    failures++;
+    std::printf("FAILED: %s\n", what.c_str());
+}
+
+/** A stdin that gives the characters fed to it and blocks until more come or it is closed. */
+class FedBuf : public std::streambuf {
+public:
+    void feed(const std::string & text) {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            for (char c : text) pending_.push_back(c);
+        }
+        changed_.notify_all();
+    }
+
+    void close() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            closed_ = true;
+        }
+        changed_.notify_all();
+    }
+
+protected:
+    int_type underflow() override {
+        std::unique_lock<std::mutex> lock(mutex_);
+        changed_.wait(lock, [&] { return !pending_.empty() || closed_; });
+        if (pending_.empty()) return traits_type::eof();
+        current_ = pending_.front();
+        pending_.pop_front();
+        setg(&current_, &current_, &current_ + 1);
+        return traits_type::to_int_type(current_);
+    }
+
+private:
+    std::mutex mutex_;
+    std::condition_variable changed_;
+    std::deque<char> pending_;
+    bool closed_ = false;
+    char current_ = 0;
+};
+
+/** A path for the protocol's log in the temporary folder, unique to this rig. */
+std::string log_path() {
+    std::random_device random;
+    const auto now = std::chrono::steady_clock::now().time_since_epoch().count();
+    const std::string name = "worker-inbox-check-" + std::to_string((long long) now) + "-" + std::to_string(random()) + ".log";
+    return (std::filesystem::temp_directory_path() / name).string();
+}
+
+FILE * open_log(const std::string & path) {
+    FILE * out = std::fopen(path.c_str(), "wb");
+    if (!out) {
+        std::printf("worker-inbox-check: cannot open the log %s\n", path.c_str());
+        std::exit(1);
+    }
+    return out;
+}
+
+/** An inbox on a model of `task`, its stdin read by a thread, and what the protocol wrote, read back from a file. */
+class Rig {
+public:
+    explicit Rig(speech_task task, const std::string & name = "Fake")
+        : path_(log_path()),
+          out_(open_log(path_)),
+          protocol_(out_),
+          inbox_(protocol_, task, name, [](const Job &) { return std::string(); }),
+          in_(&buf_) {
+        reader_ = std::thread([this] { inbox_.read(in_); });
+    }
+
+    ~Rig() {
+        close();
+        if (out_) std::fclose(out_);
+        std::remove(path_.c_str());
+    }
+
+    Inbox & inbox() { return inbox_; }
+
+    /** Feeds a line and waits until the inbox has read it and every line before it. */
+    void send(const std::string & line) {
+        buf_.feed(line + "\n");
+        const std::string id = "sync" + std::to_string(++syncs_);
+        buf_.feed("{\"type\":\"sync\",\"id\":\"" + id + "\"}\n");
+        for (int i = 0; i < 5000; i++) {
+            for (const JsonValue & m : written()) {
+                const JsonValue * mid = m.member("id");
+                if (mid && mid->text == id) {
+                    // The sync's own error is not part of what a check looks at.
+                    skip_.push_back(id);
+                    return;
+                }
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+        expect(false, "the inbox did not read " + line);
+    }
+
+    /** Every message written so far but the answers to the syncs. */
+    std::vector<JsonValue> messages() {
+        std::vector<JsonValue> out;
+        for (JsonValue & m : written()) {
+            const JsonValue * id = m.member("id");
+            bool sync = false;
+            for (const std::string & s : skip_) sync = sync || (id && id->text == s);
+            if (!sync) out.push_back(std::move(m));
+        }
+        return out;
+    }
+
+    void close() {
+        buf_.close();
+        if (reader_.joinable()) reader_.join();
+    }
+
+private:
+    std::vector<JsonValue> written() {
+        // The protocol writes through its own stream, so that reading it back never moves where it writes.
+        std::vector<JsonValue> out;
+        FILE * in = std::fopen(path_.c_str(), "rb");
+        if (!in) return out;
+        std::string line;
+        for (int c; (c = std::fgetc(in)) != EOF;) {
+            if (c != '\n') {
+                line += (char) c;
+                continue;
+            }
+            out.push_back(parse_json(line));
+            line.clear();
+        }
+        std::fclose(in);
+        return out;
+    }
+
+    std::string path_;
+    FILE * out_;
+    Protocol protocol_;
+    Inbox inbox_;
+    FedBuf buf_;
+    std::istream in_;
+    std::thread reader_;
+    int syncs_ = 0;
+    std::vector<std::string> skip_;
+};
+
+const char * const kBattle = R"("speakers":[{"speak_first":true},{"speak_first":false}],"max_frames":8)";
+
+std::string battle(const std::string & id) {
+    return R"({"type":"battle","id":")" + id + R"(",)" + kBattle + "}";
+}
+
+/**
+ * Takes the next job, which the check expects queued, giving up after 5 seconds: a battle that was refused leaves the
+ * queue empty and take() would wait for ever. Closing stdin makes take() return, so the wait ends.
+ */
+bool queued(Rig & rig, Job & job) {
+    std::future<bool> taken = std::async(std::launch::async, [&] { return rig.inbox().take(job); });
+    if (taken.wait_for(std::chrono::seconds(5)) != std::future_status::ready) {
+        rig.close();
+        taken.wait();
+        expect(false, "the battle was not queued");
+        return false;
+    }
+    if (!taken.get()) {
+        expect(false, "the battle was not queued");
+        return false;
+    }
+    return true;
+}
+
+/** The error code of an `error` message, or its type where it is another. */
+std::string kind_of(const JsonValue & m) {
+    const JsonValue * type = m.member("type");
+    return type ? type->text : "";
+}
+
+std::string option_of(const JsonValue & m) {
+    const JsonValue * error = m.member("error");
+    const JsonValue * option = error ? error->member("option") : nullptr;
+    return option && option->kind == JsonValue::Kind::String ? option->text : "";
+}
+
+bool has_id(const JsonValue & m, const std::string & id) {
+    const JsonValue * v = m.member("id");
+    return v && v->text == id;
+}
+
+void check_other_model() {
+    Rig rig(SPEECH_TASK_SYNTHESIS, "Fake-TTS");
+    rig.send(battle("b"));
+    const std::vector<JsonValue> out = rig.messages();
+    expect(out.size() == 1 && kind_of(out[0]) == "error" && option_of(out[0]) == "type" && has_id(out[0], "b"),
+           "a battle on a model that is not a dialogue model was not refused naming type, under its id");
+}
+
+void check_duplicate() {
+    Rig rig(SPEECH_TASK_DIALOGUE);
+    rig.send(battle("b"));
+    expect(rig.messages().empty(), "a battle was answered before it ran");
+    rig.send(battle("b"));
+    const std::vector<JsonValue> out = rig.messages();
+    expect(out.size() == 1 && kind_of(out[0]) == "error" && option_of(out[0]) == "id" && out[0].member("id") == nullptr,
+           "a battle under an id in flight was not refused naming id, without an id");
+}
+
+void check_hang_up() {
+    Rig rig(SPEECH_TASK_DIALOGUE);
+    rig.send(battle("b"));
+    Job job;
+    if (!queued(rig, job)) return;
+    expect(job.kind == Job::Kind::Battle && job.id == "b" && job.battle.max_frames == 8,
+           "the battle was not queued as a job with its length");
+    Cancellation cancellation;
+    expect(rig.inbox().start(job, &cancellation), "a battle that waited was not started");
+    expect(rig.inbox().asked(job) == BattleAsk::GoOn, "a battle asked for something before any line");
+    rig.send(R"({"type":"hang_up","id":"b"})");
+    expect(rig.inbox().asked(job) == BattleAsk::HangUp, "a hang_up was not read as a hang_up");
+    expect(rig.messages().empty(), "a hang_up of a running battle was answered");
+    // A second hang_up is refused, and without the battle's id, which would read as the battle's answer.
+    rig.send(R"({"type":"hang_up","id":"b"})");
+    const std::vector<JsonValue> twice = rig.messages();
+    expect(twice.size() == 1 && kind_of(twice[0]) == "error" && option_of(twice[0]) == "id" && twice[0].member("id") == nullptr,
+           "a second hang_up was not refused naming id, without an id");
+    rig.inbox().finish(job, R"({"type":"end","id":"b","frames":0})");
+}
+
+void check_hang_up_while_waiting() {
+    Rig rig(SPEECH_TASK_DIALOGUE);
+    rig.send(battle("b"));
+    rig.send(R"({"type":"hang_up","id":"b"})");
+    Job job;
+    if (!queued(rig, job)) return;
+    Cancellation cancellation;
+    expect(rig.inbox().start(job, &cancellation) && rig.inbox().asked(job) == BattleAsk::HangUp,
+           "a hang_up before the battle was taken was not asked as a hang_up");
+    rig.inbox().finish(job, R"({"type":"end","id":"b","frames":0})");
+}
+
+void check_cancel() {
+    Rig rig(SPEECH_TASK_DIALOGUE);
+    rig.send(battle("c"));
+    rig.send(R"({"type":"cancel","id":"c"})");
+    const std::vector<JsonValue> out = rig.messages();
+    expect(out.size() == 1 && kind_of(out[0]) == "cancelled" && has_id(out[0], "c"), "a cancel of a queued battle was not answered once with cancelled");
+    Job job;
+    if (!queued(rig, job)) return;
+    expect(job.id == "c", "the cancelled battle was not given");
+    Cancellation cancellation;
+    expect(!rig.inbox().start(job, &cancellation), "a cancelled battle was started");
+    rig.send(R"({"type":"chunk","id":"c","seq":0,"pcm":""})");
+    rig.send(R"({"type":"hang_up","id":"c"})");
+    expect(rig.messages().size() == 1, "the lines after a cancel were not dropped");
+
+    rig.send(battle("d"));
+    Job running;
+    if (!queued(rig, running)) return;
+    expect(running.id == "d" && rig.inbox().start(running, &cancellation), "a second battle was not started");
+    rig.send(R"({"type":"cancel","id":"d"})");
+    expect(rig.inbox().asked(running) == BattleAsk::Cancel, "a cancel of a running battle was not asked as a cancel");
+    expect(rig.messages().size() == 1, "a cancel of a running battle was answered before the battle ended");
+    rig.inbox().finish(running, R"({"type":"cancelled","id":"d"})");
+}
+
+void check_chunk_and_dropping() {
+    Rig rig(SPEECH_TASK_DIALOGUE);
+    rig.send(battle("b"));
+    rig.send(R"({"type":"chunk","id":"b","seq":0,"pcm":""})");
+    const std::vector<JsonValue> out = rig.messages();
+    expect(out.size() == 1 && kind_of(out[0]) == "error" && option_of(out[0]) == "id" && out[0].member("id") == nullptr,
+           "a chunk sent to a battle was not refused naming id, without an id");
+
+    Job job;
+    Cancellation cancellation;
+    if (!queued(rig, job)) return;
+    expect(rig.inbox().start(job, &cancellation), "the battle was not started");
+    // The battle ends of itself, before its hang_up: the lines its caller sent before it saw the end are dropped.
+    rig.inbox().finish(job, R"({"type":"end","id":"b","frames":8})");
+    rig.send(R"({"type":"chunk","id":"b","seq":1,"pcm":""})");
+    rig.send(R"({"type":"hang_up","id":"b"})");
+    expect(rig.messages().size() == 2 && kind_of(rig.messages()[1]) == "end", "the lines after a battle's end were not dropped, up to its hang_up");
+    // The dropping ended with the hang_up, so one more is refused.
+    rig.send(R"({"type":"hang_up","id":"b"})");
+    const std::vector<JsonValue> after = rig.messages();
+    expect(after.size() == 3 && kind_of(after[2]) == "error" && after[2].member("id") == nullptr, "a hang_up after the dropping ended was not refused without an id");
+}
+
+}  // namespace
+
+int main() {
+    check_other_model();
+    check_duplicate();
+    check_hang_up();
+    check_hang_up_while_waiting();
+    check_cancel();
+    check_chunk_and_dropping();
+    std::printf("inbox: a battle refused on another model and under an id in flight, a chunk refused, hang_up and cancel read\n");
+    std::printf("inbox: the lines after a battle's end dropped\n");
+    if (failures > 0) {
+        std::printf("worker-inbox-check: %d failed\n", failures);
+        return 1;
+    }
+    std::printf("worker-inbox-check: passed\n");
+    return 0;
+}
