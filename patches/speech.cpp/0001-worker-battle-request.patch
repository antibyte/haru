@@ -0,0 +1,112 @@
+#include "battle.h"
+
+#include <climits>
+#include <stdexcept>
+#include <utility>
+
+namespace {
+
+/** Reads speaker `index`'s object of option members into `out`; false with the input at fault and why. */
+bool read_speaker(const JsonValue & speaker, size_t index, std::vector<RequestOption> & out, std::string & option, std::string & problem) {
+    const std::string who = "speaker " + std::to_string(index);
+    if (speaker.kind != JsonValue::Kind::Object) {
+        option = "speakers";
+        problem = who + " is " + json_excerpt(speaker) + "; give each speaker as an object of the options of a dialogue";
+        return false;
+    }
+    for (const auto & [name, value] : speaker.members) {
+        // A member set to null counts as left out, as in a line.
+        if (value.kind == JsonValue::Kind::Null) continue;
+        option = name;
+        speech_option o;
+        if (!option_named(name, o)) {
+            problem = who + " has no member \"" + name + "\"; a speaker's members are the options " + option_names();
+            return false;
+        }
+        if (o == SPEECH_OPT_MAX_SECONDS) {
+            problem = who + " sets max_seconds, which the battle's max_frames sets for both speakers; leave it out";
+            return false;
+        }
+        try {
+            out.push_back({o, option_from_json(o, value)});
+        } catch (const std::invalid_argument & e) {
+            problem = who + ": " + e.what();
+            return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace
+
+bool read_battle(const JsonValue & message, Battle & out, std::string & option, std::string & problem) {
+    for (const auto & member : message.members) {
+        const std::string & name = member.first;
+        if (name == "type" || name == "id" || name == "speakers" || name == "max_frames") continue;
+        option = name;
+        problem = "battle has no member \"" + name +
+                  "\"; its members are type, id, speakers and max_frames, and a speaker's options, its seed among them, go into its object";
+        return false;
+    }
+    option = "speakers";
+    const JsonValue * speakers = message.member("speakers");
+    if (!speakers) {
+        problem = "the battle has no \"speakers\", an array of the two speakers' options";
+        return false;
+    }
+    if (speakers->kind != JsonValue::Kind::Array || speakers->items.size() != 2) {
+        problem = "\"speakers\" is " + json_excerpt(*speakers) + "; give an array of two objects, each the options of a dialogue";
+        return false;
+    }
+    for (size_t i = 0; i < 2; i++) {
+        if (!read_speaker(speakers->items[i], i, out.speakers[i], option, problem)) return false;
+    }
+    option = "max_frames";
+    const JsonValue * frames = message.member("max_frames");
+    if (!frames) {
+        problem = "the battle has no \"max_frames\", the most frames each speaker gives";
+        return false;
+    }
+    if (frames->is_integer() && frames->text.size() <= 12) {
+        const long long n = std::stoll(frames->text);
+        if (n >= 1 && n <= INT_MAX) {
+            out.max_frames = n;
+            return true;
+        }
+    }
+    problem = "\"max_frames\" is " + json_excerpt(*frames) + "; give the most frames each speaker gives as a whole number from 1";
+    return false;
+}
+
+Failure speaker_failure(int index, const Failure & failure) {
+    const std::string option = failure.option() == "max_seconds" ? "max_frames" : failure.option();
+    return Failure(failure.code(), option, "speaker " + std::to_string(index) + ": " + failure.what());
+}
+
+BattleEnd run_battle(BattleSpeaker & first, BattleSpeaker & second, int64_t max_frames, int64_t frame_samples,
+                     const std::function<BattleAsk()> & ask, const std::function<void(int, int64_t, const BattleFrame &)> & sink) {
+    BattleSpeaker * speakers[2] = {&first, &second};
+    std::vector<float> before[2];
+    BattleEnd end;
+    for (int64_t t = 0; t < max_frames; t++) {
+        const BattleAsk asked = ask();
+        if (asked != BattleAsk::GoOn) {
+            end.stop = asked == BattleAsk::Cancel ? BattleStop::Cancel : BattleStop::HangUp;
+            return end;
+        }
+        BattleFrame out[2];
+        for (int i = 0; i < 2; i++) {
+            out[i] = t == 0 ? speakers[i]->start() : speakers[i]->step(before[1 - i]);
+            if ((int64_t) out[i].audio.size() != frame_samples) {
+                throw std::runtime_error("frame " + std::to_string(t) + " of speaker " + std::to_string(i) + " is " +
+                                         std::to_string(out[i].audio.size()) + " samples, not a frame of " + std::to_string(frame_samples));
+            }
+            sink(i, t, out[i]);
+        }
+        // Both speakers of frame t heard the frames of t - 1, so the frames of t become what each hears next only now.
+        for (int i = 0; i < 2; i++) before[i] = std::move(out[i].audio);
+        end.frames = t + 1;
+    }
+    end.stop = BattleStop::MaxFrames;
+    return end;
+}
