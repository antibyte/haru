+Failure speaker_failure(int index, const Failure & failure);
+
+/** A frame a speaker gives: its samples at the model's rate and the text it began in them. */
+struct BattleFrame {
+    std::vector<float> audio;
+    std::string text;
+};
+
+/** A speaker of a battle: start() gives its first frame, step() hears a frame of the other's and gives its next. */
+class BattleSpeaker {
+public:
+    virtual ~BattleSpeaker() = default;
+    virtual BattleFrame start() = 0;
+    virtual BattleFrame step(const std::vector<float> & heard) = 0;
+};
+
+/** What the caller has asked of a running battle, read before each frame: nothing, its hang_up, or its cancel. */
+enum class BattleAsk { GoOn, HangUp, Cancel };
+
+/** Why a battle ended: its max_frames, its hang_up (or the end of stdin), or its cancel. */
+enum class BattleStop { MaxFrames, HangUp, Cancel };
+
+/** How a battle ended: the frames each speaker gave, and why. */
+struct BattleEnd {
+    int64_t frames = 0;
+    BattleStop stop = BattleStop::MaxFrames;
+};
+
+/**
+ * Runs up to `max_frames` frames of a battle. Frame 0 is each speaker's start(); in frame t each speaker's step() hears
+ * the other's frame t - 1, a_t = A.step(b_{t-1}) and b_t = B.step(a_{t-1}), so that each hears the other one frame late,
+ * as a conversation hears its caller. `ask` is read before each frame, and a hang_up or a cancel ends the battle there,
+ * after whole frames. `sink` gets each frame as it comes with its speaker and number, speaker 0's before speaker 1's. A
+ * frame that is not `frame_samples` long throws std::runtime_error.
+ */
+BattleEnd run_battle(BattleSpeaker & first, BattleSpeaker & second, int64_t max_frames, int64_t frame_samples,
+                     const std::function<BattleAsk()> & ask, const std::function<void(int, int64_t, const BattleFrame &)> & sink);
